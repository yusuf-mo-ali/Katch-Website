# Public form endpoint. Leave unset to use the included /api/contact Vercel Function.
VITE_CONTACT_ENDPOINT=/api/contact

# Required by api/contact.js in production.
RESEND_API_KEY=re_xxxxxxxxx
KATCH_CONTACT_EMAIL=projects@your-real-domain.com
RESEND_FROM_EMAIL=Katch Website <website@your-verified-domain.com>

# Optional: comma-separated list of accepted production origins.
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com